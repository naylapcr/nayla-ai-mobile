<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:clipToPadding="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="40dp">

        <!-- 1. Header Section -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:background="@drawable/gradient_blue" />

            <!-- Card Profil Utama -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="80dp"
                android:layout_marginBottom="20dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="8dp">

                <!-- Background disamakan dengan dashboard (#E3F2FD) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="258dp"
                    android:background="@color/card_light_blue"
                    android:clipChildren="false"
                    android:clipToPadding="false"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="10dp"
                    android:paddingBottom="30dp">

                    <com.google.android.material.card.MaterialCardView
                        android:layout_width="100dp"
                        android:layout_height="100dp"
                        android:layout_marginTop="-50dp"
                        app:cardCornerRadius="50dp"
                        app:cardElevation="10dp"
                        app:strokeColor="@color/white"
                        app:strokeWidth="4dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:scaleType="centerCrop"
                            android:src="@drawable/profil" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="Nayla"
                        android:textColor="@color/text_primary"
                        android:textSize="22sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sistem Informasi • PCR"
                        android:textColor="@color/text_muted"
                        android:textSize="14sp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </RelativeLayout>

        <!-- 2. Informasi Kontak -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="INFORMASI KONTAK"
                android:textColor="#546E7A"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginBottom="12dp"
                android:letterSpacing="0.1"/>

            <!-- Email Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_light_blue"
                    android:padding="16dp">

                    <View
                        android:id="@+id/iconEmail"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/mail"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/labelEmail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="Email"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        app:layout_constraintStart_toEndOf="@id/iconEmail"
                        app:layout_constraintTop_toTopOf="@id/iconEmail" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="nayla24si@mahasiswa.pcr.ac.id"
                        android:textColor="#37474F"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="@id/labelEmail"
                        app:layout_constraintTop_toBottomOf="@id/labelEmail" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- LinkedIn Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="24dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@color/card_light_blue"
                    android:padding="16dp">

                    <View
                        android:id="@+id/iconLinkedIn"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:background="@drawable/linkedin"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                    <TextView
                        android:id="@+id/labelLinkedIn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="LinkedIn Profile"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp"
                        app:layout_constraintStart_toEndOf="@id/iconLinkedIn"
                        app:layout_constraintTop_toTopOf="@id/iconLinkedIn" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="linkedin.com/in/naylapcr"
                        android:textColor="#37474F"
                        android:textStyle="bold"
                        android:textSize="14sp"
                        app:layout_constraintStart_toStartOf="@id/labelLinkedIn"
                        app:layout_constraintTop_toBottomOf="@id/labelLinkedIn" />
                </androidx.constraintlayout.widget.ConstraintLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tombol Logout -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="55dp"
                android:text="Logout"
                android:textColor="#D32F2F"
                app:backgroundTint="#FFEBEE"
                app:cornerRadius="16dp"
                app:elevation="0dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>