<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:gravity="center"
    android:background="@color/bg_fun">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard"
        android:textSize="24sp"
        android:textStyle="bold"
        android:textColor="@color/text_dark"
        android:layout_marginBottom="30dp"/>

    <Button
        android:id="@+id/btnP2"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Kalkulator Bangun Ruang"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/primary_fun"/>

    <Button
        android:id="@+id/btnG1"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Lihat Koleksi Tas 1"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/accent_fun"/>

    <Button
        android:id="@+id/btnG2"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Lihat Koleksi Tas 2"
        android:layout_marginBottom="10dp"
        android:backgroundTint="@color/accent_fun"/>

    <Button
        android:id="@+id/btnP3"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Login"
        android:layout_marginBottom="30dp"
        android:backgroundTint="@color/primary_fun"/>

    <TextView
        android:id="@+id/btnLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Logout dari Aplikasi"
        android:textColor="@color/accent_fun"
        android:textStyle="bold"/>

</LinearLayout>