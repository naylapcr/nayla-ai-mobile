<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:clipToPadding="false"
            android:paddingBottom="100dp">

            <!-- 1. Top Section: Branding & Greeting -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="90dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_home_header" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginStart="24dp"
                    android:layout_marginTop="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Home"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        android:textColor="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Explore Your Village"
                        android:textSize="14sp"
                        android:textColor="#E0E7FF"
                        android:layout_marginTop="0dp" />
                </LinearLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="0dp"
                    app:cardBackgroundColor="#33FFFFFF"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="24dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/profil"
                        android:scaleType="centerCrop" />

                </com.google.android.material.card.MaterialCardView>
            </RelativeLayout>

            <!-- 2. Highlight Card: Agenda Kegiatan Desa -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="-25dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="8dp">

                <!-- Tambahkan background #E3F2FD di sini agar seluruh kartu seragam -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/card_light_blue"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Agenda Terdekat"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#90A4AE"
                        android:textAllCaps="true"
                        android:letterSpacing="0.1"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical">

                        <!-- Kotak Tanggal (Warna tetap kontras agar terbaca) -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="60dp"
                            android:layout_height="65dp"
                            app:cardCornerRadius="16dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardElevation="0dp">
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:gravity="center"
                                android:orientation="vertical">
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="05"
                                    android:textSize="20sp"
                                    android:textStyle="bold"
                                    android:textColor="#1A237E"/>
                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MEI"
                                    android:textSize="10sp"
                                    android:textStyle="bold"
                                    android:textColor="#1A237E"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                        <!-- Detail Acara -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Musyawarah Pembangunan"
                                android:textSize="16sp"
                                android:textStyle="bold"
                                android:textColor="#1A237E"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="09:00 WIB • Balai Desa"
                                android:textSize="13sp"
                                android:textColor="#78909C"
                                android:layout_marginTop="4dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#D1E4F2"
                        android:layout_marginVertical="16dp"/>

                    <TextView
                        android:id="@+id/btnLihatSemua"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lihat semua agenda →"
                        android:textColor="#3B82F6"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 3. Grid Menu dengan Style "Glass" Modern -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Layanan Cepat"
                android:textStyle="bold"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="30dp"
                android:textColor="#37474F"
                android:textSize="16sp"/>

            <GridLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:padding="16dp">

                <!-- Kalkulator -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnP2"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@color/card_light_blue"> <!-- Warna disamakan -->
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/calll" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Kalkulator"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp"
                            android:textColor="#1A237E"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- E-Surat -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnWebView"
                    android:layout_width="0dp"
                    android:layout_height="150dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:background="@color/card_light_blue"> <!-- Warna utama -->
                        <ImageView
                            android:layout_width="50dp"
                            android:layout_height="50dp"
                            android:src="@drawable/letter" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="E-Surat"
                            android:textStyle="bold"
                            android:layout_marginTop="12dp"
                            android:textColor="#1A237E"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Gallery I -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnG1"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@color/card_light_blue"> <!-- Warna disamakan -->
                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:src="@drawable/logobag" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Galeri I"
                            android:textStyle="bold"
                            android:layout_marginStart="10dp"
                            android:textColor="#1A237E"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Gallery II -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/btnG2"
                    android:layout_width="0dp"
                    android:layout_height="100dp"
                    android:layout_columnWeight="1"
                    android:layout_margin="8dp"
                    app:cardCornerRadius="24dp"
                    app:cardElevation="2dp">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:background="@color/card_light_blue"> <!-- Warna disamakan -->
                        <ImageView
                            android:layout_width="35dp"
                            android:layout_height="35dp"
                            android:src="@drawable/logobag" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Galeri II"
                            android:textStyle="bold"
                            android:layout_marginStart="10dp"
                            android:textColor="#1A237E"/>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </GridLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnP10"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="8dp"
                android:text="Produk Layanan Surat"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                android:backgroundTint="#E3F2FD"
                app:icon="@drawable/ic_note"
                app:iconGravity="textStart"
                android:textColor="#1A237E"
                app:iconTint="#1A237E"
                app:strokeColor="#3B82F6"
                app:strokeWidth="1dp"
                />

            <!-- 4. Footer Button: Pengajuan & Multimedia -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnP9"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:text="Pengajuan Layanan"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_message"
                app:iconGravity="textStart"
                android:backgroundTint="#3B82F6"
                android:textColor="@color/white"
                app:iconTint="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnP13"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:text="Multimedia &amp; Scan QR"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:icon="@drawable/handphone"
                app:iconGravity="textStart"
                android:backgroundTint="#673AB7"
                android:textColor="@color/white"
                app:iconTint="@color/white"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLogout"
                android:layout_width="match_parent"
                android:layout_height="65dp"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="12dp"
                android:text="Logout Session"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                app:cornerRadius="20dp"
                app:icon="@drawable/logout"
                app:iconGravity="textStart"
                android:backgroundTint="#FFEBEE"
                android:textColor="#D32F2F"
                app:iconTint="#D32F2F"
                app:strokeColor="#FFCDD2"
                app:strokeWidth="1dp"
                />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Berita Desa Terkini"
                android:textStyle="bold"
                android:layout_marginHorizontal="24dp"
                android:layout_marginTop="24dp"
                android:textColor="#37474F"
                android:textSize="18sp"/>

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvNewsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:paddingBottom="24dp" />

                <ProgressBar
                    android:id="@+id/progressBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginVertical="32dp"
                    android:visibility="gone" />
            </FrameLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>